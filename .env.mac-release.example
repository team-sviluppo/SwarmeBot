# Copy to .env.mac-release.local (git-ignored) and fill in. Read by scripts/release-mac.sh.

# Developer ID identity used to sign the app (see `security find-identity -v -p codesigning`)
MAC_SIGN_IDENTITY="Developer ID Application: Your Company (TEAMID1234)"

# Notarization: either the Apple ID trio…
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=TEAMID1234
# …or a profile saved with `xcrun notarytool store-credentials`
# NOTARY_PROFILE=AC_PASSWORD

# Sparkle EdDSA public key printed by Sparkle's generate_keys
SPARKLE_PUBLIC_KEY=

# Optional: the matching private key (base64); without it the key in the login Keychain is used
# SPARKLE_PRIVATE_KEY=

# Optional: GitHub repo the releases and the appcast are published to
# RELEASES_REPO=your-org/SwarmeBot
