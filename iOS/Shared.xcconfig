// Settings shared by Debug and Release. A developer's own values go in
// Local.xcconfig, next to this file and git-ignored:
//   DEVELOPMENT_TEAM = ABCDE12345
//   SWARMEBOT_BUNDLE_ID = <own bundle id, only for a build with its own push relay>
//   SWARMEBOT_PUSH_RELAY = https:/$()/push.example.com
// (`//` starts a comment in an xcconfig: `$()` keeps the URL whole.)
// Without a relay there are no pushes. The AWS credentials are on the relay, the APNs key on AWS:
// nothing secret is in the app or in this file.
SWARMEBOT_BUNDLE_ID = it.hextra.swarmebot
// the official build's relay, hosted next to a remote engine (docs/push-relay.md); a URL, not a secret
SWARMEBOT_PUSH_RELAY = https:/$()/swarmebot.hextra.it/swarmebot/cristiano/push
#include? "Local.xcconfig"
